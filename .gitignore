# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
/build/
/dist/
*.nvda-addon

# Virtual environments
.venv/
venv/
env/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# ---------------------------------------------------------------------------
# SECRETS — API keys / credentials must NEVER be committed.
# EyeMate uses BYO API Key (OpenAI/Anthropic/Gemini). Keep every real key out.
# ---------------------------------------------------------------------------
# allow the non-secret template (.env.example) but block real env files
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
*.p12
*.pkcs12
id_rsa
id_ed25519
*.keystore
secrets.ini
secrets.yaml
secrets.yml
credentials.json
credentials*.json
*credentials*
*.credentials
token.json
*.token
apikey*
api_key*
*_secret*
config.local.*
settings.local.*
# NVDA user config may embed provider keys
nvda-config-backup/

# ---------------------------------------------------------------------------
# PRIVACY — runtime screen captures & session data contain personal content
# (game screens, learning material, on-screen text). Never commit them.
# ---------------------------------------------------------------------------
captures/
frames/
screenshots/
*.capture.png
*.frame.png
session-logs/
*.session.json
# exported review/notes may contain screen content
*.review.md

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Scratch
/scratch/

# 대회 제출물 — 배포된 서식·안내 문서(재배포 불가)와 접수 정보가 담긴 작성본이 섞여 있습니다.
