# Bitgil — environment template. Copy to `.env` and fill in your own keys.
# `.env` is gitignored; NEVER commit real keys. BYO API Key.

# Choose one or more providers. Leave unused ones blank.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local provider (no key needed) — set the base URL if using Ollama.
OLLAMA_BASE_URL=http://localhost:11434

# Local OmniRoute gateway (keyless, OpenAI-compatible). Only needed if the
# gateway isn't on its default port — read by --base-url / BITGIL_BASE_URL.
# BITGIL_BASE_URL=http://localhost:20128/v1

# Token for a gateway with scoped auth enabled. Same variable name the omniroute
# CLI uses, so exporting it once authenticates both. BITGIL_API_KEY also works.
# OMNIROUTE_API_KEY=

# Default provider: demo | omniroute | openai | anthropic | bedrock | gemini | ollama
BITGIL_PROVIDER=ollama
